<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rossiya Mod — Learning Journey</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0c0a07;
  --surface: #181410;
  --surface2: #221e18;
  --border: #3a2e1e;
  --gold: #c9a84c;
  --gold-dim: #7a6030;
  --gold-light: #e8c96a;
  --red: #8b1a1a;
  --red-light: #c94040;
  --green: #2a5e38;
  --green-light: #4db86a;
  --text: #ede0c8;
  --text-dim: #9a8060;
  --text-muted: #4e3e28;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Crimson Pro', Georgia, serif;
  font-size: 17px;
  line-height: 1.6;
  min-height: 100vh;
}

.ambient {
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background:
    radial-gradient(ellipse at 10% 20%, rgba(139,26,26,0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 90% 80%, rgba(201,168,76,0.06) 0%, transparent 50%);
}

.wrap {
  max-width: 900px;
  margin: 0 auto;
  padding: 2rem 1.25rem 4rem;
  position: relative;
  z-index: 1;
}

header {
  text-align: center;
  padding: 2rem 0 1.75rem;
  margin-bottom: 1.75rem;
  border-bottom: 1px solid var(--border);
}

.orn { color: var(--gold-dim); font-size: 0.9rem; letter-spacing: 0.8em; display: block; margin-bottom: 0.6rem; }

h1 {
  font-family: 'Cinzel', serif;
  font-size: 2.1rem;
  font-weight: 700;
  color: var(--gold);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  margin-bottom: 0.25rem;
}

.sub { color: var(--text-dim); font-style: italic; font-size: 1rem; }

.stats-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.65rem;
  margin-bottom: 1.5rem;
}

.stat {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 0.8rem;
  text-align: center;
}

.stat-n {
  font-family: 'Cinzel', serif;
  font-size: 1.75rem;
  font-weight: 600;
  color: var(--gold);
  display: block;
  line-height: 1;
  margin-bottom: 0.2rem;
}

.stat-l {
  font-size: 0.68rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.map-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1rem 1rem 0.75rem;
  margin-bottom: 1.75rem;
}

.map-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
}

.map-label {
  font-family: 'Cinzel', serif;
  font-size: 0.72rem;
  color: var(--gold-dim);
  text-transform: uppercase;
  letter-spacing: 0.18em;
}

.map-loc {
  font-size: 0.85rem;
  color: var(--text-dim);
  font-style: italic;
}

.map-scroll { overflow-x: auto; }

.stages-list { display: flex; flex-direction: column; gap: 0.6rem; }

.stage-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
  transition: border-color 0.25s;
}

.stage-card.is-active { border-color: var(--red); }
.stage-card.is-done { border-color: var(--gold-dim); }

.stage-hdr {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.8rem 1rem;
  cursor: pointer;
  user-select: none;
  transition: background 0.15s;
}

.stage-hdr:hover { background: var(--surface2); }

.s-num {
  font-family: 'Cinzel', serif;
  font-size: 0.7rem;
  color: var(--text-muted);
  min-width: 1.2rem;
}

.s-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.s-info { flex: 1; }

.s-title {
  font-family: 'Cinzel', serif;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  display: block;
}

.s-city {
  font-size: 0.78rem;
  color: var(--text-muted);
  font-style: italic;
}

.s-prog {
  font-size: 0.78rem;
  color: var(--text-dim);
  font-style: italic;
  white-space: nowrap;
}

.s-chev {
  color: var(--text-muted);
  font-size: 0.65rem;
  transition: transform 0.2s;
}

.stage-card.collapsed .s-chev { transform: rotate(-90deg); }
.stage-card.collapsed .stage-body { display: none; }

.stage-body { border-top: 1px solid var(--border); }

.task-row {
  display: flex;
  align-items: flex-start;
  gap: 0.8rem;
  padding: 0.7rem 1rem;
  border-bottom: 1px solid var(--border);
  cursor: pointer;
  transition: background 0.12s;
}

.task-row:last-child { border-bottom: none; }
.task-row:hover { background: var(--surface2); }

.t-box {
  width: 17px; height: 17px;
  border: 1.5px solid var(--border);
  border-radius: 3px;
  flex-shrink: 0;
  margin-top: 3px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  transition: all 0.2s;
  background: var(--surface);
}

.task-row.done .t-box { background: var(--green); border-color: var(--green-light); color: #a0f0b0; }

.t-num {
  font-family: 'Cinzel', serif;
  font-size: 0.65rem;
  color: var(--text-muted);
  min-width: 1.5rem;
  margin-top: 4px;
  flex-shrink: 0;
}

.t-inner { flex: 1; }

.t-text { font-size: 0.95rem; color: var(--text); }
.task-row.done .t-text { color: var(--text-muted); text-decoration: line-through; text-decoration-color: var(--text-muted); }

.t-date { font-size: 0.7rem; color: var(--text-muted); font-style: italic; margin-top: 1px; }

.notes-card {
  margin-top: 1.5rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  overflow: hidden;
}

.notes-hdr {
  padding: 0.65rem 1rem;
  border-bottom: 1px solid var(--border);
  font-family: 'Cinzel', serif;
  font-size: 0.72rem;
  color: var(--gold-dim);
  text-transform: uppercase;
  letter-spacing: 0.14em;
}

textarea {
  width: 100%;
  background: transparent;
  border: none;
  color: var(--text);
  font-family: 'Crimson Pro', Georgia, serif;
  font-size: 1rem;
  line-height: 1.7;
  padding: 0.85rem 1rem;
  resize: vertical;
  min-height: 90px;
  outline: none;
}

textarea::placeholder { color: var(--text-muted); font-style: italic; }

.foot-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 1.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--border);
}

footer { color: var(--text-muted); font-style: italic; font-size: 0.85rem; }

.reset-btn {
  background: none;
  border: 1px solid var(--red);
  color: var(--red-light);
  font-family: 'Cinzel', serif;
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 0.35rem 0.75rem;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.2s;
}

.reset-btn:hover { background: var(--red); color: #fff; }

@keyframes bob {
  0%,100% { transform: translateY(0px); }
  50%      { transform: translateY(-5px); }
}

@keyframes ripple {
  0%   { r: 24; opacity: 0.4; }
  100% { r: 38; opacity: 0; }
}
</style>
</head>
<body>
<div class="ambient"></div>
<div class="wrap">

<header>
  <span class="orn">✦ &nbsp; ✦ &nbsp; ✦</span>
  <h1>Rossiya Mod</h1>
  <p class="sub">A modder's journey from Moscow to Vladivostok</p>
</header>

<div class="stats-row">
  <div class="stat"><span class="stat-n" id="sn-done">0</span><span class="stat-l">Completed</span></div>
  <div class="stat"><span class="stat-n" id="sn-left">34</span><span class="stat-l">Remaining</span></div>
  <div class="stat"><span class="stat-n" id="sn-stage">I</span><span class="stat-l">Current Stage</span></div>
  <div class="stat"><span class="stat-n" id="sn-pct">0%</span><span class="stat-l">Progress</span></div>
</div>

<div class="map-card">
  <div class="map-topbar">
    <span class="map-label">&#9770; Journey Map — Rossiyskaya Imperiya</span>
    <span class="map-loc" id="map-loc-label">Moskva Oblast — Stage I</span>
  </div>
  <div class="map-scroll">
    <svg id="the-map" viewBox="0 0 840 230" xmlns="http://www.w3.org/2000/svg"
      style="width:100%;min-width:600px;display:block;">

      <rect width="840" height="230" rx="6" fill="#141008"/>
      <rect x="7" y="7" width="826" height="216" rx="4" fill="none" stroke="#2e2416" stroke-width="0.5"/>
      <rect x="12" y="12" width="816" height="206" rx="3" fill="none" stroke="#2e2416" stroke-width="0.5" stroke-dasharray="5 4"/>

      <text x="420" y="222" text-anchor="middle" fill="#1e1810"
        font-family="Cinzel,serif" font-size="9" letter-spacing="10">ROSSIYSKAYA IMPERIYA</text>

      <g transform="translate(808,28)">
        <line x1="0" y1="-12" x2="0" y2="12" stroke="#3a2e1e" stroke-width="0.5"/>
        <line x1="-12" y1="0" x2="12" y2="0" stroke="#3a2e1e" stroke-width="0.5"/>
        <polygon points="0,-12 -2,-6 2,-6" fill="#3a2e1e"/>
        <text x="0" y="-14" text-anchor="middle" fill="#3a2e1e" font-size="7" font-family="Cinzel,serif">N</text>
      </g>

      <path d="M 92,178 Q 135,72 182,86 Q 226,100 274,152 Q 316,198 358,202 Q 402,205 444,132 Q 482,62 532,174 Q 572,228 622,106 Q 664,46 728,170"
        fill="none" stroke="#352818" stroke-width="2.5" stroke-dasharray="6 5"/>

      <path id="done-path" fill="none" stroke="#c9a84c" stroke-width="2.5" stroke-linecap="round" opacity="0.7"/>

      <g id="nodes"></g>
      <g id="piece"></g>
    </svg>
  </div>
</div>

<div class="stages-list" id="stages-list"></div>

<div class="notes-card">
  <div class="notes-hdr">&#9998; Field Notes — Zapiski</div>
  <textarea id="notes-ta" placeholder="Запишите открытия... Record discoveries, bugs solved, things to remember..."></textarea>
</div>

<div class="foot-row">
  <footer>Progress saved in your browser &middot; Россия велика</footer>
  <button class="reset-btn" onclick="resetAll()">Reset Progress</button>
</div>

</div>
<script>
const ROMAN = ['I','II','III','IV','V','VI','VII','VIII'];

const curriculum = [
  {
    title: "Localization & Text",
    city: "Moskva Oblast",
    color: "#c9a84c",
    tasks: [
      "Rename Russia to 'Rossiya' and update all dynamic Russian names",
      "Rename a Russian resource or good (e.g. Iron → Zheleze)",
      "Transliterate Russian law names (e.g. Serfdom → Krepostnoe Pravo)",
      "Rename key Russian cities and states on the map",
      "Transliterate Russian government types (Empire → Imperiya, Republic → Respublika)"
    ]
  },
  {
    title: "Tweaking Numbers",
    city: "Sankt-Peterburg",
    color: "#7a9bcf",
    tasks: [
      "Change Russia's starting treasury",
      "Change a technology's research cost",
      "Change a building's output or efficiency",
      "Modify Russia's starting literacy or bureaucracy values"
    ]
  },
  {
    title: "History Files",
    city: "Velikiy Novgorod",
    color: "#8fba7a",
    tasks: [
      "Change Russia's starting laws (e.g. abolish serfdom from day one)",
      "Change the Tsar's starting name and stats",
      "Give Russia extra starting buildings — factories and railways",
      "Change which territories Russia controls at game start"
    ]
  },
  {
    title: "Events",
    city: "Kazan",
    color: "#cf8f7a",
    tasks: [
      "Create a simple event that fires at Russia's game start",
      "Create a Decembrist Revolt event with multiple outcomes",
      "Create an event that fires when Russia reaches a condition",
      "Create a serf emancipation event chain"
    ]
  },
  {
    title: "Decisions",
    city: "Yekaterinburg",
    color: "#a87acf",
    tasks: [
      "Create a simple manually triggered decision",
      "Create a Pan-Slavism decision with requirements",
      "Create a Trans-Siberian Railway construction decision with meaningful effects"
    ]
  },
  {
    title: "Modifying Existing Systems",
    city: "Omsk",
    color: "#cf7aab",
    tasks: [
      "Add a new production method to an existing Russian building",
      "Create a new Russian nationalist political movement",
      "Add a new goods or resource to the game",
      "Modify how an existing Russian technology works"
    ]
  },
  {
    title: "Creating New Content",
    city: "Irkutsk",
    color: "#7acfcf",
    tasks: [
      "Create a new Siberian fur trade building from scratch",
      "Create a Trans-Siberian Railway technology",
      "Create a new Russian law with custom political effects",
      "Create a Siberian expansion journal entry with milestones"
    ]
  },
  {
    title: "The Siberian Republic",
    city: "Vladivostok",
    color: "#cfba7a",
    tasks: [
      "Create the Siberian Republic as a new country tag",
      "Set up its starting history — territory, laws, and ruler",
      "Add Russian localization for the new country",
      "Design and add a custom flag for the Siberian Republic",
      "Write a custom starting event for the Siberian Republic",
      "Create a journal entry with goals for the Siberian Republic to achieve"
    ]
  }
];

const nodes = [
  { x: 92,  y: 178, l1: "Moskva",     l2: "Oblast" },
  { x: 182, y: 86,  l1: "Sankt-",     l2: "Peterburg" },
  { x: 274, y: 152, l1: "Velikiy",    l2: "Novgorod" },
  { x: 358, y: 202, l1: "Kazan",      l2: "" },
  { x: 444, y: 132, l1: "Yekate-",    l2: "rinburg" },
  { x: 532, y: 174, l1: "Omsk",       l2: "" },
  { x: 622, y: 106, l1: "Irkutsk",    l2: "" },
  { x: 728, y: 170, l1: "Vladi-",     l2: "vostok" }
];

let state = {};
let notesVal = '';
try { state = JSON.parse(localStorage.getItem('rossiya_v2') || '{}'); } catch(e){}
notesVal = localStorage.getItem('rossiya_notes_v2') || '';

const ns = 'http://www.w3.org/2000/svg';
function svgEl(tag, attrs, text) {
  const el = document.createElementNS(ns, tag);
  if (attrs) Object.entries(attrs).forEach(([k,v]) => el.setAttribute(k,v));
  if (text !== undefined) el.textContent = text;
  return el;
}

function stageProg(si) {
  const total = curriculum[si].tasks.length;
  const done  = curriculum[si].tasks.filter((_,ti) => state[si+'_'+ti]).length;
  return { done, total, pct: total ? done/total : 0 };
}

function totalDone() { return Object.values(state).filter(Boolean).length; }
function totalAll()  { return curriculum.reduce((a,s) => a + s.tasks.length, 0); }

function currentStageIdx() {
  for (let si = 0; si < curriculum.length; si++) {
    const { done, total } = stageProg(si);
    if (done < total) return si;
  }
  return curriculum.length - 1;
}

function save() {
  localStorage.setItem('rossiya_v2', JSON.stringify(state));
  const ta = document.getElementById('notes-ta');
  if (ta) localStorage.setItem('rossiya_notes_v2', ta.value);
}

function updateStats() {
  const done  = totalDone();
  const total = totalAll();
  const pct   = Math.round(done / total * 100);
  const cur   = currentStageIdx();

  document.getElementById('sn-done').textContent  = done;
  document.getElementById('sn-left').textContent  = total - done;
  document.getElementById('sn-stage').textContent = ROMAN[cur];
  document.getElementById('sn-pct').textContent   = pct + '%';

  const n = nodes[cur];
  document.getElementById('map-loc-label').textContent =
    (n.l1 + n.l2).replace('-','') + ' — Stage ' + ROMAN[cur];

  curriculum.forEach((_,si) => {
    const { done: d, total: t } = stageProg(si);
    const el = document.getElementById('sp-'+si);
    if (el) el.textContent = d + ' / ' + t;
    const card = document.getElementById('sc-'+si);
    if (card) {
      card.classList.remove('is-active','is-done');
      if (d === t) card.classList.add('is-done');
      else if (si === cur) card.classList.add('is-active');
    }
  });

  drawMap();
}

function drawMap() {
  const nodesG = document.getElementById('nodes');
  const pieceG = document.getElementById('piece');
  if (!nodesG || !pieceG) return;
  nodesG.innerHTML = '';
  pieceG.innerHTML = '';

  const cur = currentStageIdx();
  const R = 20;
  const circ = 2 * Math.PI * R;

  nodes.forEach((pos, si) => {
    const { done, total, pct } = stageProg(si);
    const isComplete = done === total;
    const isCurrent  = si === cur && !isComplete;
    const isPast     = si < cur || isComplete;

    const g = svgEl('g', { transform: `translate(${pos.x},${pos.y})`, style: 'cursor:pointer' });
    g.onclick = () => scrollToStage(si);

    if (isCurrent) {
      const ripple = svgEl('circle', { r: '24', fill: 'none', stroke: '#8b1a1a', 'stroke-width': '1', opacity: '0' });
      const anim = svgEl('animate', {
        attributeName: 'r', from: '22', to: '38',
        dur: '2s', repeatCount: 'indefinite'
      });
      const animOp = svgEl('animate', {
        attributeName: 'opacity', from: '0.4', to: '0',
        dur: '2s', repeatCount: 'indefinite'
      });
      ripple.appendChild(anim);
      ripple.appendChild(animOp);
      g.appendChild(ripple);
    }

    g.appendChild(svgEl('circle', {
      r: R, fill: 'none',
      stroke: isPast ? '#5a4020' : '#241c10',
      'stroke-width': '2.5'
    }));

    if (pct > 0) {
      g.appendChild(svgEl('circle', {
        r: R, fill: 'none',
        stroke: isComplete ? '#c9a84c' : '#8b1a1a',
        'stroke-width': '2.5',
        'stroke-dasharray': `${pct * circ} ${circ}`,
        'stroke-dashoffset': circ * 0.25,
        'stroke-linecap': 'round',
        transform: 'rotate(-90)'
      }));
    }

    g.appendChild(svgEl('circle', {
      r: R - 5,
      fill: isComplete ? '#231900' : isCurrent ? '#180808' : '#0c0a07',
      stroke: isComplete ? '#c9a84c' : isCurrent ? '#8b1a1a' : '#2e2416',
      'stroke-width': '1'
    }));

    const lbl = svgEl('text', {
      'text-anchor': 'middle',
      'dominant-baseline': 'central',
      fill: isComplete ? '#c9a84c' : isCurrent ? '#c94040' : '#4a3822',
      'font-family': 'Cinzel,serif',
      'font-size': '10',
      'font-weight': '600'
    }, isComplete ? '✓' : ROMAN[si]);
    g.appendChild(lbl);

    const fillC = isComplete ? '#907030' : isCurrent ? '#7a4030' : '#322818';
    const l1 = svgEl('text', {
      'text-anchor': 'middle',
      y: R + 13,
      fill: fillC,
      'font-family': 'Crimson Pro,serif',
      'font-size': '8.5',
      'font-style': 'italic'
    }, pos.l1);
    g.appendChild(l1);

    if (pos.l2) {
      const l2 = svgEl('text', {
        'text-anchor': 'middle',
        y: R + 22,
        fill: fillC,
        'font-family': 'Crimson Pro,serif',
        'font-size': '8.5',
        'font-style': 'italic'
      }, pos.l2);
      g.appendChild(l2);
    }

    nodesG.appendChild(g);
  });

  const cp = nodes[cur];
  const pg = svgEl('g', { transform: `translate(${cp.x},${cp.y - 34})`, style: 'animation: bob 2.2s ease-in-out infinite' });

  pg.appendChild(svgEl('circle', {
    r: '12', fill: '#6e1010',
    stroke: '#c9a84c', 'stroke-width': '1.5'
  }));

  pg.appendChild(svgEl('text', {
    'text-anchor': 'middle',
    'dominant-baseline': 'central',
    fill: '#e8c96a',
    'font-size': '13'
  }, '♛'));

  pg.appendChild(svgEl('line', {
    x1: '0', y1: '12', x2: '0', y2: '23',
    stroke: '#8b1a1a', 'stroke-width': '1',
    'stroke-dasharray': '2 2'
  }));

  pieceG.appendChild(pg);
}

function scrollToStage(si) {
  const el = document.getElementById('sc-'+si);
  if (!el) return;
  el.classList.remove('collapsed');
  setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'start' }), 50);
}

function toggleTask(si, ti) {
  const key = si+'_'+ti;
  if (state[key]) { delete state[key]; }
  else { state[key] = new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}); }
  const row = document.getElementById('tr-'+key);
  if (row) {
    row.classList.toggle('done', !!state[key]);
    row.querySelector('.t-box').textContent = state[key] ? '✓' : '';
    const dt = row.querySelector('.t-date');
    if (dt) dt.textContent = state[key] ? 'Completed ' + state[key] : '';
  }
  save();
  updateStats();
}

function toggleStage(si) {
  document.getElementById('sc-'+si).classList.toggle('collapsed');
}

function resetAll() {
  if (!confirm('Reset all progress? This cannot be undone.')) return;
  state = {};
  localStorage.removeItem('rossiya_v2');
  document.querySelectorAll('.task-row').forEach(r => r.classList.remove('done'));
  document.querySelectorAll('.t-box').forEach(b => b.textContent = '');
  document.querySelectorAll('.t-date').forEach(d => d.textContent = '');
  updateStats();
}

function buildUI() {
  const list = document.getElementById('stages-list');
  let absN = 0;

  curriculum.forEach((stage, si) => {
    const { done, total } = stageProg(si);
    const card = document.createElement('div');
    card.className = 'stage-card' + (si > 0 ? ' collapsed' : '');
    card.id = 'sc-'+si;

    card.innerHTML = `
      <div class="stage-hdr" onclick="toggleStage(${si})">
        <span class="s-num">${ROMAN[si]}.</span>
        <div class="s-dot" style="background:${stage.color}"></div>
        <div class="s-info">
          <span class="s-title">${stage.title}</span>
          <span class="s-city">${stage.city}</span>
        </div>
        <span class="s-prog" id="sp-${si}">${done} / ${total}</span>
        <span class="s-chev">&#9660;</span>
      </div>
      <div class="stage-body" id="sb-${si}"></div>
    `;
    list.appendChild(card);

    const body = document.getElementById('sb-'+si);
    stage.tasks.forEach((task, ti) => {
      const key = si+'_'+ti;
      const isDone = !!state[key];
      const dt = state[key] || '';
      absN++;

      const row = document.createElement('div');
      row.className = 'task-row' + (isDone ? ' done' : '');
      row.id = 'tr-'+key;
      row.onclick = () => toggleTask(si, ti);
      row.innerHTML = `
        <div class="t-box">${isDone ? '✓' : ''}</div>
        <span class="t-num">${absN}.</span>
        <div class="t-inner">
          <div class="t-text">${task}</div>
          <div class="t-date">${dt ? 'Completed ' + dt : ''}</div>
        </div>
      `;
      body.appendChild(row);
    });
  });

  const ta = document.getElementById('notes-ta');
  ta.value = notesVal;
  ta.addEventListener('input', save);

  updateStats();
}

buildUI();
</script>
</body>
</html>
