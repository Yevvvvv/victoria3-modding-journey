<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vic3 Mod Learning Tracker</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300&display=swap');

  :root {
    --bg: #0e0c0a;
    --surface: #1a1612;
    --surface2: #231f1a;
    --border: #3a3028;
    --gold: #c9a84c;
    --gold-dim: #8a6f2e;
    --gold-glow: #e8c96a;
    --red: #8b2020;
    --red-light: #c94040;
    --green: #2a6b3a;
    --green-light: #4a9b5a;
    --text: #e8dcc8;
    --text-dim: #9a8a72;
    --text-muted: #5a4e3e;
    --stage-colors: #c9a84c, #7a9bcf, #8fba7a, #cf8f7a, #a87acf, #cf7aab, #7acfcf, #cfba7a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: 17px;
    line-height: 1.6;
    min-height: 100vh;
  }

  .bg-pattern {
    position: fixed;
    inset: 0;
    background-image: 
      radial-gradient(ellipse at 20% 20%, rgba(201,168,76,0.04) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 80%, rgba(139,32,32,0.06) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    position: relative;
    z-index: 1;
  }

  header {
    text-align: center;
    padding: 2.5rem 0 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .crown {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    display: block;
  }

  h1 {
    font-family: 'Cinzel', serif;
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .subtitle {
    color: var(--text-dim);
    font-style: italic;
    font-size: 1rem;
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .stat {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem;
    text-align: center;
  }

  .stat-num {
    font-family: 'Cinzel', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--gold);
    display: block;
    line-height: 1;
    margin-bottom: 0.3rem;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .progress-bar-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
  }

  .progress-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .progress-track {
    height: 8px;
    background: var(--surface2);
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--gold-dim), var(--gold));
    border-radius: 4px;
    transition: width 0.5s ease;
  }

  .stage {
    margin-bottom: 1.75rem;
  }

  .stage-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px 6px 0 0;
    cursor: pointer;
    user-select: none;
  }

  .stage-header:hover {
    border-color: var(--gold-dim);
  }

  .stage-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .stage-title {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    flex: 1;
  }

  .stage-progress {
    font-size: 0.8rem;
    color: var(--text-dim);
    font-style: italic;
  }

  .stage-chevron {
    color: var(--text-muted);
    font-size: 0.75rem;
    transition: transform 0.2s;
  }

  .stage.collapsed .stage-chevron {
    transform: rotate(-90deg);
  }

  .stage-body {
    border: 1px solid var(--border);
    border-top: none;
    border-radius: 0 0 6px 6px;
    overflow: hidden;
  }

  .stage.collapsed .stage-body {
    display: none;
  }

  .task {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: background 0.15s;
  }

  .task:last-child { border-bottom: none; }
  .task:hover { background: var(--surface2); }

  .task-check {
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--border);
    border-radius: 3px;
    flex-shrink: 0;
    margin-top: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    background: var(--surface);
  }

  .task.done .task-check {
    background: var(--green);
    border-color: var(--green-light);
  }

  .task.done .task-check::after {
    content: '✓';
    color: #a0f0b0;
    font-size: 13px;
    font-weight: bold;
  }

  .task-num {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    color: var(--text-muted);
    min-width: 1.5rem;
    margin-top: 3px;
  }

  .task-text {
    flex: 1;
    font-size: 1rem;
    color: var(--text);
  }

  .task.done .task-text {
    color: var(--text-muted);
    text-decoration: line-through;
    text-decoration-color: var(--text-muted);
  }

  .task-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
    white-space: nowrap;
    margin-top: 3px;
  }

  .notes-section {
    margin-top: 2.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .notes-header {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  textarea {
    width: 100%;
    background: transparent;
    border: none;
    color: var(--text);
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: 1rem;
    line-height: 1.7;
    padding: 1rem;
    resize: vertical;
    min-height: 120px;
    outline: none;
  }

  textarea::placeholder { color: var(--text-muted); font-style: italic; }

  .reset-btn {
    margin-top: 1.5rem;
    background: none;
    border: 1px solid var(--red);
    color: var(--red-light);
    font-family: 'Cinzel', serif;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .reset-btn:hover {
    background: var(--red);
    color: #fff;
  }

  footer {
    text-align: center;
    margin-top: 3rem;
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.9rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }
</style>
</head>
<body>
<div class="bg-pattern"></div>
<div class="container">

  <header>
    <span class="crown">♛</span>
    <h1>Victoria 3 Mod Curriculum</h1>
    <p class="subtitle">From country names to custom nations — a modder's journey</p>
  </header>

  <div class="stats-bar">
    <div class="stat">
      <span class="stat-num" id="stat-done">0</span>
      <span class="stat-label">Completed</span>
    </div>
    <div class="stat">
      <span class="stat-num" id="stat-remain">33</span>
      <span class="stat-label">Remaining</span>
    </div>
    <div class="stat">
      <span class="stat-num" id="stat-pct">0%</span>
      <span class="stat-label">Progress</span>
    </div>
  </div>

  <div class="progress-bar-wrap">
    <div class="progress-label">
      <span>Overall Progress</span>
      <span id="prog-label">0 / 33 lessons</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill" id="prog-fill" style="width: 0%"></div>
    </div>
  </div>

  <div id="stages"></div>

  <div class="notes-section">
    <div class="notes-header">&#9998; Field Notes</div>
    <textarea id="notes" placeholder="Record discoveries, errors you solved, things to remember..."></textarea>
  </div>

  <button class="reset-btn" onclick="resetAll()">Reset all progress</button>

  <footer>Progress is saved automatically in your browser &middot; Developed with Claude</footer>
</div>

<script>
const curriculum = [
  {
    title: "Stage 1 — Localization & Text",
    tasks: [
      "Rename an existing country",
      "Rename a good or resource (e.g. rename Coal to something custom)",
      "Rename a law or political system",
      "Rename a technology"
    ]
  },
  {
    title: "Stage 2 — Tweaking Numbers",
    tasks: [
      "Change a country's starting treasury",
      "Change a technology's research cost",
      "Change a building's output",
      "Change a law's effect"
    ]
  },
  {
    title: "Stage 3 — History Files",
    tasks: [
      "Change a country's starting laws",
      "Change a country's starting ruler name and stats",
      "Give a country extra starting buildings",
      "Change which country owns a province at game start"
    ]
  },
  {
    title: "Stage 4 — Events",
    tasks: [
      "Create a simple event that fires at game start",
      "Create an event with multiple choices",
      "Create an event that fires based on a condition",
      "Create a chain of connected events that tell a story"
    ]
  },
  {
    title: "Stage 5 — Decisions",
    tasks: [
      "Create a simple decision the player can manually trigger",
      "Create a decision with requirements",
      "Create a decision with meaningful effects"
    ]
  },
  {
    title: "Stage 6 — Modifying Existing Systems",
    tasks: [
      "Add a new production method to an existing building",
      "Create a new ideology or political movement",
      "Add a new goods/resource to the game",
      "Modify how an existing technology works"
    ]
  },
  {
    title: "Stage 7 — Creating New Content",
    tasks: [
      "Create a brand new building from scratch",
      "Create a brand new technology",
      "Create a new law with custom effects",
      "Create a new journal entry (mission/quest for the player)"
    ]
  },
  {
    title: "Stage 8 — Creating a New Country",
    tasks: [
      "Create a new tag and define the country's basic identity",
      "Set up the country's starting history (territory, laws, ruler)",
      "Add custom localization for country name and adjective",
      "Add a custom flag",
      "Write a custom starting event for your new country",
      "Add a journal entry with goals for your new country"
    ]
  }
];

const stageColors = ['#c9a84c','#7a9bcf','#8fba7a','#cf8f7a','#a87acf','#cf7aab','#7acfcf','#cfba7a'];

let state = JSON.parse(localStorage.getItem('vic3tracker') || '{}');
let notes = localStorage.getItem('vic3notes') || '';

function save() {
  localStorage.setItem('vic3tracker', JSON.stringify(state));
  localStorage.setItem('vic3notes', document.getElementById('notes').value);
}

function totalTasks() {
  return curriculum.reduce((a, s) => a + s.tasks.length, 0);
}

function doneTasks() {
  return Object.values(state).filter(Boolean).length;
}

function updateStats() {
  const total = totalTasks();
  const done = doneTasks();
  const pct = Math.round((done / total) * 100);
  document.getElementById('stat-done').textContent = done;
  document.getElementById('stat-remain').textContent = total - done;
  document.getElementById('stat-pct').textContent = pct + '%';
  document.getElementById('prog-fill').style.width = pct + '%';
  document.getElementById('prog-label').textContent = done + ' / ' + total + ' lessons';

  curriculum.forEach((stage, si) => {
    const stageDone = stage.tasks.filter((_, ti) => state[si + '_' + ti]).length;
    const el = document.getElementById('stage-prog-' + si);
    if (el) el.textContent = stageDone + ' / ' + stage.tasks.length;
  });
}

function toggleTask(si, ti) {
  const key = si + '_' + ti;
  if (state[key]) {
    delete state[key];
  } else {
    state[key] = new Date().toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'});
  }
  const taskEl = document.getElementById('task-' + si + '_' + ti);
  if (taskEl) {
    taskEl.classList.toggle('done', !!state[key]);
    const dateEl = taskEl.querySelector('.task-date');
    if (dateEl) dateEl.textContent = state[key] || '';
  }
  save();
  updateStats();
}

function toggleStage(si) {
  const el = document.getElementById('stage-' + si);
  el.classList.toggle('collapsed');
}

function resetAll() {
  if (!confirm('Reset all progress? This cannot be undone.')) return;
  state = {};
  localStorage.removeItem('vic3tracker');
  document.querySelectorAll('.task').forEach(t => t.classList.remove('done'));
  document.querySelectorAll('.task-date').forEach(t => t.textContent = '');
  updateStats();
}

function render() {
  const container = document.getElementById('stages');
  let taskNum = 0;

  curriculum.forEach((stage, si) => {
    taskNum++;
    const stageEl = document.createElement('div');
    stageEl.className = 'stage';
    stageEl.id = 'stage-' + si;

    const color = stageColors[si % stageColors.length];
    const stageDone = stage.tasks.filter((_, ti) => state[si + '_' + ti]).length;

    stageEl.innerHTML = `
      <div class="stage-header" onclick="toggleStage(${si})">
        <div class="stage-dot" style="background:${color}"></div>
        <span class="stage-title">${stage.title}</span>
        <span class="stage-progress" id="stage-prog-${si}">${stageDone} / ${stage.tasks.length}</span>
        <span class="stage-chevron">&#9660;</span>
      </div>
      <div class="stage-body" id="stage-body-${si}"></div>
    `;

    container.appendChild(stageEl);

    const body = document.getElementById('stage-body-' + si);
    stage.tasks.forEach((task, ti) => {
      const key = si + '_' + ti;
      const done = !!state[key];
      const date = state[key] || '';
      const absNum = curriculum.slice(0, si).reduce((a, s) => a + s.tasks.length, 0) + ti + 1;

      const taskEl = document.createElement('div');
      taskEl.className = 'task' + (done ? ' done' : '');
      taskEl.id = 'task-' + key;
      taskEl.onclick = () => toggleTask(si, ti);
      taskEl.innerHTML = `
        <div class="task-check"></div>
        <span class="task-num">${absNum}.</span>
        <span class="task-text">${task}</span>
        <span class="task-date">${date}</span>
      `;
      body.appendChild(taskEl);
    });
  });

  document.getElementById('notes').value = notes;
  document.getElementById('notes').addEventListener('input', save);
  updateStats();
}

render();

const first = document.getElementById('stage-0');
if (first) first.classList.add('');
for (let i = 1; i < curriculum.length; i++) {
  const el = document.getElementById('stage-' + i);
  if (el) el.classList.add('collapsed');
}
</script>
</body>
</html>
